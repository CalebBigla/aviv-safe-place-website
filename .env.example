# --- Public (safe in the browser bundle) ------------------------------------
# Supabase project reference from supabase/config.toml.
SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Project URL and publishable key. The publishable key is safe for browser use
# because Row Level Security protects every table.
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public site origin, e.g. https://avivsafeplace.com (no trailing slash).
# Enables canonical URLs, og:url, share images, structured data and absolute
# sitemap links. Leave empty in local development.
VITE_SITE_URL=

# --- Server only (never prefix with VITE_) ----------------------------------
# Required by guest booking holds, guest booking links, the contact form and
# rate limiting. Supabase dashboard -> Project Settings -> API keys (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct PostgreSQL URL used only by `npm run db:migrate` (drizzle-kit).
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Bearer token for scheduled internal endpoints. Not used yet (no scheduled
# jobs exist); reserved for later phases.
CRON_SECRET=replace-with-a-random-secret

# --- Local development only -------------------------------------------------
# Disposable local PostgreSQL for `npm run test:db` (must be localhost).
# AVIV_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/postgres

# Not yet integrated (do not add until those phases): Paystack, Daily.co, email.
