# --- Public (safe in the browser bundle) ------------------------------------
# Supabase project reference from supabase/config.toml.
SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Project URL and publishable key. The publishable key is safe for browser use
# because Row Level Security protects every table.
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public site origin, e.g. https://avivsafeplace.com (no trailing slash).
# Enables canonical URLs, og:url, share images, structured data and absolute
# sitemap links. Leave empty in local development.
VITE_SITE_URL=

# Cloudflare Turnstile site key (public). Pairs with TURNSTILE_SECRET_KEY below.
VITE_TURNSTILE_SITE_KEY=

# --- Server only (never prefix with VITE_) ----------------------------------
# Required by guest booking holds, guest booking links, the contact form and
# rate limiting. Supabase dashboard -> Project Settings -> API keys (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct PostgreSQL URL used only by `npm run db:migrate` (drizzle-kit).
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Agora video sessions. Both come from the Agora console (Projects -> your project).
# The project must have the App Certificate enabled, otherwise Agora does not enforce tokens.
# Without these values session pages say video is unavailable; no room is created.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Confirmation emails, sent through Resend (resend.com). Without these, confirming an appointment
# still works and the administrator is told no email was sent. EMAIL_FROM must use a domain verified
# in Resend, e.g. "AVIV Safe Place <hello@avivsafeplace.com>". EMAIL_REPLY_TO is optional.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Bot check on the hold and contact forms (Cloudflare Turnstile, free). Set both to switch it on;
# with neither, the forms still work but rely on rate limits alone.
TURNSTILE_SECRET_KEY=

# Bearer token for scheduled internal endpoints. Not used yet (no scheduled
# jobs exist); reserved for later phases.
CRON_SECRET=replace-with-a-random-secret

# --- Local development only -------------------------------------------------
# Disposable local PostgreSQL for `npm run test:db` (must be localhost).
# AVIV_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/postgres

# Paystack secret key: sk_test_... for testing, sk_live_... for real payments. In the Paystack
# dashboard (Settings -> API Keys & Webhooks) set the webhook URL to
# https://<your-site>/api/paystack/webhook, separately for test and live mode.
PAYSTACK_SECRET_KEY=
